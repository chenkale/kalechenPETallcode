\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Channel time offset convergence. These clearly show the two timing populations (can even be argued that 4 are visible per ASIC, but fitting just 2 populations is sufficient for convergence). The convergence is expected, this is just to check that the algorithm is working.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:convergence_time_alignment}{{10}{13}{Channel time offset convergence. These clearly show the two timing populations (can even be argued that 4 are visible per ASIC, but fitting just 2 populations is sufficient for convergence). The convergence is expected, this is just to check that the algorithm is working}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Quantitative Validation}{13}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Siddon projection for vertical line source path at 30 1-second windows. Some offset from intended path.}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:vertpath}{{11}{14}{Siddon projection for vertical line source path at 30 1-second windows. Some offset from intended path}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Left: global time difference distirbution for iterations 0, 1, 3, and 10. Right: mean and FWHM of global distribution plotted across iterations 0-10, a fit of the FWHM suggests a converging FWHM of 513ps. This agrees with a per-LOR CTR calculation of about 520ps, which directly computes the FWHM of all coincidence events in high activity LORs.}}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:ctr}{{12}{14}{Left: global time difference distirbution for iterations 0, 1, 3, and 10. Right: mean and FWHM of global distribution plotted across iterations 0-10, a fit of the FWHM suggests a converging FWHM of 513ps. This agrees with a per-LOR CTR calculation of about 520ps, which directly computes the FWHM of all coincidence events in high activity LORs}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Left: global time difference distribution without calibration split into the 4 timing populations caused by each module's 2 populations, giving 4 combinations. Right: with calibration, the 4 populations converge onto each other at 0ps.}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:global4peaks}{{13}{15}{Left: global time difference distribution without calibration split into the 4 timing populations caused by each module's 2 populations, giving 4 combinations. Right: with calibration, the 4 populations converge onto each other at 0ps}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Left: heatmap of the timing FWHMs of all channels. Right: CTR estimate computed only involving only 10\% best performing channels. We see improvement of roughly 11\% in the CTR estimate. }}{15}{figure.caption.16}\protected@file@percent }
\newlabel{fig:bestctr}{{14}{15}{Left: heatmap of the timing FWHMs of all channels. Right: CTR estimate computed only involving only 10\% best performing channels. We see improvement of roughly 11\% in the CTR estimate}{figure.caption.16}{}}
